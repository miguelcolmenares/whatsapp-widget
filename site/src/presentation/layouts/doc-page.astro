---
import type { Document } from "@/domain";
import { ArrowLeft, ArrowRight, PanelLeftClose, PanelLeftOpen, PanelRightClose, PanelRightOpen } from "lucide-react";
import { loadSite } from "@/infrastructure";
import { Breadcrumbs } from "@/presentation/components/site/breadcrumbs";
import { PageInfo } from "@/presentation/components/site/page-info";
import { SideCard } from "@/presentation/components/site/side-card";
import BaseLayout from "./base-layout.astro";

interface Props {
  doc: Document;
  html: string;
  headings: { depth: number; slug: string; text: string }[];
  siblings: Document[];
  collectionLabel: string;
  collectionHref: string;
  homeHref: string;
}
const { doc, html, headings, siblings, collectionLabel, collectionHref, homeHref } = Astro.props;
const index = siblings.findIndex((sibling) => sibling.route === doc.route);
const previous = index > 0 ? siblings[index - 1] : undefined;
const next = index >= 0 && index < siblings.length - 1 ? siblings[index + 1] : undefined;
const site = loadSite();
const { href } = site;
const { editUrl, updated } = site.pageMeta(doc);
const toc = headings.filter((heading) => heading.depth === 2 || heading.depth === 3);
// A page with a card in its frontmatter is a detail page: the card sits beside the text, in the place of the
// table of contents, and above the text on a phone. Without a card nothing here changes.
const card = doc.card;
// The table of contents is the right sidebar of a page without a card. Only such a page has a control for it.
const hasToc = !card && toc.length > 0;
// A sidebar is hidden with a button, and the button stays in a 44 px column, so the text takes the space.
const sidebarButton =
  "group inline-flex min-h-11 min-w-11 items-center justify-center rounded-md text-fg-muted transition-colors hover:bg-surface-2 hover:text-fg-bright";
---

<BaseLayout title={doc.title} description={doc.description || undefined}>
  <Fragment slot="head">
    <!-- Before the first paint: the sidebars that the reader hid on this site, from the choice kept in the browser. -->
    <!-- The sidebars and "On this page" are in a file of their own, loaded after the page with defer. -->
    <script is:inline type="module" src={href("docs-page.js")} defer></script>
    <script is:inline define:vars={{ hasToc }}>
      (function () {
        var root = document.documentElement;
        function hidden(name) {
          try {
            return localStorage.getItem("docs-" + name) === "hidden";
          } catch (error) {
            return false;
          }
        }
        if (hidden("menu")) root.setAttribute("data-docs-menu", "hidden");
        if (hasToc && hidden("toc")) root.setAttribute("data-docs-toc", "hidden");
      })();
    </script>
  </Fragment>
  <div
    class:list={[
      "mx-auto grid max-w-site grid-cols-1 gap-10 px-5 py-10 transition-[grid-template-columns] duration-200 ease-site motion-reduce:transition-none",
      card ? "xl:grid-cols-[var(--docs-menu-col)_minmax(0,1fr)]" : "lg:grid-cols-[var(--docs-menu-col)_minmax(0,1fr)_var(--docs-toc-col)]",
    ]}
  >
    <div class:list={["min-w-0", card ? "hidden xl:block" : "hidden lg:block"]}>
      <div class="sticky top-24">
        <div class="flex justify-end">
          <button
            type="button"
            hidden
            data-sidebar-toggle="menu"
            aria-controls="docs-menu"
            aria-expanded="true"
            aria-label="Hide the docs menu"
            class:list={[sidebarButton, card ? "max-xl:hidden" : "max-lg:hidden"]}
          >
            <PanelLeftClose className="size-5 group-aria-[expanded=false]:hidden" aria-hidden="true" />
            <PanelLeftOpen className="hidden size-5 group-aria-[expanded=false]:block" aria-hidden="true" />
          </button>
        </div>
        <nav id="docs-menu" aria-label={collectionLabel}>
          <p class="mb-3 font-mono text-[11px] tracking-[0.14em] text-fg-dim uppercase">{collectionLabel}</p>
          <ul class="space-y-1">
            {
              siblings.map((sibling, position) => (
                <li>
                  {sibling.group && sibling.group.name !== siblings[position - 1]?.group?.name && (
                    <p class="mt-4 mb-1 px-3 font-mono text-[11px] tracking-[0.14em] text-fg-dim uppercase">{sibling.group.name}</p>
                  )}
                  <a
                    href={sibling.route}
                    aria-current={sibling.route === doc.route ? "page" : undefined}
                    class="block rounded-md px-3 py-1.5 text-sm text-fg-muted transition-colors hover:text-fg-bright aria-[current=page]:bg-surface-2 aria-[current=page]:text-fg-bright"
                  >
                    {sibling.title}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </div>

    <article
      class:list={[
        "min-w-0",
        card
          ? "lg:grid lg:grid-cols-[minmax(0,1fr)_16rem] lg:gap-x-10 lg:[&>:not(aside)]:col-start-1"
          : "w-full mx-auto max-w-prose transition-[max-width] duration-200 ease-site in-data-[docs-menu=hidden]:max-w-[80ch] in-data-[docs-toc=hidden]:max-w-[80ch] motion-reduce:transition-none",
      ]}
    >
      <Breadcrumbs items={[{ label: "Home", href: homeHref }, { label: collectionLabel, href: collectionHref }, { label: doc.title }]} />
      <h1 class="mt-6 text-balance text-[clamp(2rem,5vw,3rem)] leading-[1.08] font-semibold tracking-[-0.035em] text-fg-bright">{doc.title}</h1>
      {doc.description && doc.descriptionSource === "frontmatter" && <p class="mt-4 text-lg leading-relaxed text-fg-muted">{doc.description}</p>}
      {
        card && (
          <>
            <SideCard
              rows={card.rows}
              links={card.links}
              tags={card.tags}
              className="mt-8 lg:col-start-2 lg:row-span-6 lg:row-start-1 lg:mt-0"
            />
            <script is:inline>
              (function () {
                var card = document.currentScript.previousElementSibling;
                var toggle = card && card.querySelector("[data-side-card-toggle]");
                if (toggle) {
                  card.dataset.js = "";
                  toggle.hidden = false;
                }
              })();
            </script>
          </>
        )
      }
      <slot />
      <div class="prose-site mt-10" set:html={html} data-prose />
      <PageInfo editUrl={editUrl} updated={updated} />
      <nav aria-label="Previous and next" class="mt-16 grid grid-cols-1 gap-4 border-t border-border pt-8 sm:grid-cols-2">
        {
          previous ? (
            <a href={previous.route} class="group rounded-lg border border-border p-4 transition-colors hover:border-border-hover">
              <span class="flex items-center gap-1.5 text-xs text-fg-dim"><ArrowLeft className="size-3.5" aria-hidden="true" /> Previous</span>
              <span class="mt-1 block font-medium text-fg-bright">{previous.title}</span>
            </a>
          ) : (
            <span />
          )
        }
        {
          next && (
            <a href={next.route} class="group rounded-lg border border-border p-4 text-right transition-colors hover:border-border-hover">
              <span class="flex items-center justify-end gap-1.5 text-xs text-fg-dim">Next <ArrowRight className="size-3.5" aria-hidden="true" /></span>
              <span class="mt-1 block font-medium text-fg-bright">{next.title}</span>
            </a>
          )
        }
      </nav>
    </article>

    {
      !card && (
        <div class="hidden min-w-0 lg:block">
          {
            hasToc && (
              <div class="sticky top-24">
                <div class="flex justify-start">
                  <button
                    type="button"
                    hidden
                    data-sidebar-toggle="toc"
                    aria-controls="docs-toc"
                    aria-expanded="true"
                    aria-label="Hide the table of contents"
                    class:list={[sidebarButton, "max-lg:hidden"]}
                  >
                    <PanelRightClose className="size-5 group-aria-[expanded=false]:hidden" aria-hidden="true" />
                    <PanelRightOpen className="hidden size-5 group-aria-[expanded=false]:block" aria-hidden="true" />
                  </button>
                </div>
                <nav
                  id="docs-toc"
                  aria-label="On this page"
                  tabindex="0"
                  data-on-this-page
                  class="max-h-[calc(100dvh_-_10rem)] overflow-y-auto"
                >
                  <p class="mb-3 font-mono text-[11px] tracking-[0.14em] text-fg-dim uppercase">On this page</p>
                  <ul class="space-y-1.5 text-sm">
                    {toc.map((heading) => (
                      <li>
                        <a
                          href={`#${heading.slug}`}
                          class:list={[
                            "block border-l-2 border-transparent py-0.5 text-fg-muted hover:text-fg-bright aria-[current=location]:border-brand aria-[current=location]:text-brand",
                            heading.depth === 3 ? "pl-6" : "pl-3",
                          ]}
                        >
                          {heading.text}
                        </a>
                      </li>
                    ))}
                  </ul>
                </nav>
              </div>
            )
          }
        </div>
      )
    }
  </div>
</BaseLayout>

<style is:global>
  /* The width of each sidebar of a docs page. A hidden sidebar keeps a 44 px column, where its button is. */
  :root {
    --docs-menu-col: 220px;
    --docs-toc-col: 200px;
  }
  :root[data-docs-menu="hidden"] {
    --docs-menu-col: 2.75rem;
  }
  :root[data-docs-toc="hidden"] {
    --docs-toc-col: 2.75rem;
  }
  :root[data-docs-menu="hidden"] #docs-menu,
  :root[data-docs-toc="hidden"] #docs-toc {
    display: none;
  }
</style>

<script>
  // The copy buttons are in the HTML, hidden. This shows them and copies the code on a click.
  import "@/presentation/code/copy-code";
  import { attachSideCard } from "@/presentation/side-card/side-card";

  const card = document.querySelector<HTMLElement>("[data-side-card]");
  if (card) attachSideCard(card);
</script>
