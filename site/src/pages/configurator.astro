---
import { buttonVariants } from "../presentation/components/ui/button";
import BaseLayout from "../presentation/layouts/BaseLayout.astro";
import { DAY_NAMES, DEFAULT_CONFIG, buildCode } from "../presentation/tools/widgetCode";

// The page is sent with the default choices already in place, so the code reads without JavaScript.
const config = DEFAULT_CONFIG;
const outline = `${buttonVariants({ variant: "outline" })} min-h-11`;
---

<BaseLayout
  title="Configurator"
  description="Set the title, the description and the agents of the WhatsApp widget, see it working on this page, and copy the code for your own."
>
  <div class="mx-auto max-w-site px-5 py-14">
    <h1 class="text-3xl font-semibold text-fg-bright">Widget configurator</h1>
    <p class="mt-3 max-w-prose text-fg-muted">
      Set the texts and the agents. The code on the right follows what you type, and the widget in the corner of this
      page is the preview: open it to see what a visitor sees. Then copy the code to the end of your page. See{" "}
      <a href="../docs/getting-started/">Getting started</a> and the <a href="../docs/options/">options</a> for what each
      field does.
    </p>

    <div class="tool" data-tool>
      <div class="form">
        <section aria-labelledby="widget-heading">
          <h2 id="widget-heading">Widget</h2>
          <div class="field">
            <label for="widget-title">Title</label>
            <input type="text" id="widget-title" placeholder="Widget title" value={config.title} autocomplete="off" />
          </div>
          <div class="field">
            <label for="widget-description">Description</label>
            <textarea id="widget-description" rows="3" placeholder="Widget description" autocomplete="off">{config.description}</textarea>
          </div>
        </section>

        <section aria-labelledby="agents-heading">
          <h2 id="agents-heading">Agents</h2>
          <noscript><p class="note">The form needs JavaScript. The code shown is the default one.</p></noscript>
          <div id="agents-container" class="agents"></div>
          <button type="button" class={`${outline} add-agent`} data-add-agent>Add agent</button>
        </section>
      </div>

      <section class="output" aria-labelledby="code-heading">
        <h2 id="code-heading">Integration code</h2>
        <p class="note">Copy and paste this code at the end of your page:</p>
        <pre id="code-output" class="code" role="region" aria-label="Code to copy" tabindex="0">{buildCode(config)}</pre>
        <div class="copy-row">
          <button type="button" class={`${outline} copy-btn`} data-copy>Copy code</button>
          <p class="status" role="status" data-copy-status></p>
        </div>
      </section>
    </div>
  </div>

  <!-- One agent card. The script copies it for each agent and sets the ids, the names and the values. -->
  <template id="agent-template">
    <article class="agent-card">
      <div class="agent-head">
        <h3 class="agent-title" data-agent-title></h3>
        <button type="button" class={outline} data-remove-agent>Remove</button>
      </div>

      <div class="field">
        <label data-for="name">Agent name</label>
        <input type="text" data-field="name" placeholder="Agent name e.g. Customer Service" autocomplete="off" />
      </div>
      <div class="field">
        <label data-for="phone">WhatsApp phone</label>
        <input type="text" data-field="phone" placeholder="WhatsApp phone number" autocomplete="off" />
      </div>
      <div class="field">
        <label data-for="hours">Working hours</label>
        <input type="text" data-field="hours" placeholder="Working hours" autocomplete="off" />
      </div>
      <div class="field">
        <label data-for="cta">Button text</label>
        <input type="text" data-field="cta" placeholder="Click button text" autocomplete="off" />
      </div>
      <div class="field">
        <label data-for="message">Initial chat message</label>
        <textarea data-field="message" rows="2" placeholder="Message to start the chat" autocomplete="off"></textarea>
      </div>

      <fieldset class="schedule">
        <legend>Daily schedule</legend>
        {
          DAY_NAMES.map((day) => (
            <div class="day" data-day>
              <span class="day-name" data-day-name>{day}</span>
              <input type="checkbox" role="switch" class="switch" data-switch />
              <div class="time-inputs" data-times>
                <input type="time" data-time="open" />
                <span aria-hidden="true">to</span>
                <input type="time" data-time="close" />
              </div>
            </div>
          ))
        }
      </fieldset>
    </article>
  </template>
</BaseLayout>

<style>
  .tool {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 2rem;
    margin-top: 2rem;
  }
  @media (min-width: 64rem) {
    .tool {
      grid-template-columns: minmax(0, 28rem) minmax(0, 1fr);
      align-items: start;
    }
    .output {
      position: sticky;
      top: calc(var(--sk-layout-nav-h) + 1.5rem);
    }
  }
  .form,
  .agents {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    gap: 1.5rem;
    min-width: 0;
  }
  .agents {
    margin-bottom: 1.5rem;
  }
  .output {
    min-width: 0;
  }
  h2 {
    margin-bottom: 0.75rem;
    color: var(--sk-fg-bright);
    font-size: 1.125rem;
    font-weight: 600;
  }
  .note {
    margin-bottom: 0.75rem;
    color: var(--sk-fg-muted);
    font-size: 0.875rem;
  }
  .field {
    display: grid;
    gap: 0.375rem;
    margin-bottom: 1rem;
  }
  label,
  legend {
    color: var(--sk-fg);
    font-size: 0.875rem;
    font-weight: 500;
  }
  input:not([type="checkbox"]),
  textarea {
    width: 100%;
    min-height: 2.75rem;
    padding: 0.625rem 0.75rem;
    color: var(--sk-fg-bright);
    background: var(--sk-surface);
    border: 1px solid var(--sk-border-strong);
    border-radius: var(--sk-radius-md);
    font: inherit;
  }
  textarea {
    resize: vertical;
  }
  input:focus-visible,
  textarea:focus-visible,
  pre:focus-visible {
    outline: 2px solid var(--sk-accent);
    outline-offset: 2px;
  }

  /* An agent */
  .agent-card {
    padding: 1.25rem;
    background: var(--sk-bg-subtle);
    border: 1px solid var(--sk-border);
    border-radius: var(--sk-radius-lg);
  }
  .agent-head {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem;
    margin-bottom: 1rem;
  }
  .agent-head [hidden] {
    display: none;
  }
  .agent-title {
    color: var(--sk-fg-bright);
    font-size: 1rem;
    font-weight: 600;
  }

  /* The week */
  .schedule {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }
  .schedule legend {
    margin-bottom: 0.25rem;
    padding: 0;
  }
  .day {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.5rem 0.75rem;
    min-height: 2.75rem;
    padding: 0.25rem 0;
    border-bottom: 1px solid var(--sk-border);
  }
  .day:last-child {
    border-bottom: 0;
  }
  .day-name {
    flex: 1 1 6rem;
    color: var(--sk-fg);
    font-size: 0.875rem;
  }
  .time-inputs {
    display: none;
    align-items: center;
    gap: 0.5rem;
    color: var(--sk-fg-muted);
    font-size: 0.875rem;
  }
  .time-inputs[data-on] {
    display: flex;
    flex-wrap: wrap;
  }
  .time-inputs input {
    width: 8.25rem;
    padding-inline: 0.5rem;
  }
  .switch {
    appearance: none;
    flex: none;
    position: relative;
    width: 2.75rem;
    height: 1.75rem;
    margin: 0;
    background: var(--sk-surface-3);
    border: 1px solid var(--sk-border-strong);
    border-radius: 999px;
    cursor: pointer;
    transition: background-color 150ms var(--sk-motion-ease);
  }
  .switch::after {
    content: "";
    position: absolute;
    top: 0.1875rem;
    left: 0.1875rem;
    width: 1.1875rem;
    height: 1.1875rem;
    background: var(--sk-fg-bright);
    border-radius: 50%;
    transition: transform 150ms var(--sk-motion-ease);
  }
  .switch:checked {
    background: var(--sk-accent-strong);
    border-color: var(--sk-accent-strong);
  }
  .switch:checked::after {
    background: var(--sk-accent-contrast);
    transform: translateX(1rem);
  }
  .switch:focus-visible {
    outline: 2px solid var(--sk-accent);
    outline-offset: 2px;
  }

  /* The code */
  .code {
    max-height: 32rem;
    overflow: auto;
    padding: 1rem;
    color: var(--sk-fg);
    background: var(--sk-surface);
    border: 1px solid var(--sk-border);
    border-radius: var(--sk-radius-md);
    font-family: var(--sk-font-mono);
    font-size: 0.8125rem;
    line-height: 1.6;
    white-space: pre-wrap;
    overflow-wrap: anywhere;
  }
  .copy-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    margin-top: 0.75rem;
  }
  .status {
    min-height: 1.5rem;
    color: var(--sk-success);
    font-size: 0.875rem;
  }
</style>

<script>
  import {
    DAY_NAMES,
    DEFAULT_CONFIG,
    buildCode,
    newAgent,
    timeValue,
    worksOn,
    type AgentConfig,
    type WidgetConfig,
  } from "../presentation/tools/widgetCode";

  type TextField = "name" | "phone" | "hours" | "cta" | "message";

  /** What the form holds. The page was sent with the default one. */
  const config: WidgetConfig = structuredClone(DEFAULT_CONFIG);

  const byId = <T extends HTMLElement>(id: string) => document.getElementById(id) as T;
  const query = <T extends HTMLElement>(root: ParentNode, selector: string) => root.querySelector(selector) as T;

  const title = byId<HTMLInputElement>("widget-title");
  const description = byId<HTMLTextAreaElement>("widget-description");
  const container = byId<HTMLElement>("agents-container");
  const output = byId<HTMLElement>("code-output");
  const template = byId<HTMLTemplateElement>("agent-template");
  const copyButton = query<HTMLButtonElement>(document, "[data-copy]");
  const copyStatus = query<HTMLElement>(document, "[data-copy-status]");

  // The preview ---------------------------------------------------------------------------------------------------

  type Widget = { widget?: HTMLElement };
  type WidgetConstructor = new (options: { title: string; description: string; agents: AgentConfig[] }) => Widget;
  const widgetWindow = window as unknown as { whatsapp?: WidgetConstructor };
  const WIDGET_SRC = `${import.meta.env.BASE_URL.replace(/\/?$/, "/")}dist/js/whatsapp-widget.js`;

  let widgetLoaded = false;
  let previewTimer: number | undefined;

  /** Draws the widget with what the form holds now, in place of the one that was there. */
  function mountPreview() {
    if (!widgetWindow.whatsapp) return;
    document.querySelectorAll(".wa-w").forEach((element) => element.remove());
    new widgetWindow.whatsapp({
      title: config.title,
      description: config.description,
      agents: config.agents,
    });
  }

  /** The widget is built a moment after the last change, as a form fires many events while a person types. */
  function schedulePreview() {
    if (!widgetLoaded) return;
    window.clearTimeout(previewTimer);
    previewTimer = window.setTimeout(mountPreview, 150);
  }

  const script = document.createElement("script");
  script.src = WIDGET_SRC;
  script.addEventListener("load", () => {
    widgetLoaded = true;
    mountPreview();
  });
  document.head.append(script);

  // The code ------------------------------------------------------------------------------------------------------

  function update() {
    output.textContent = buildCode(config);
    schedulePreview();
  }

  title.addEventListener("input", () => {
    config.title = title.value;
    update();
  });
  description.addEventListener("input", () => {
    config.description = description.value;
    update();
  });

  // The agents ----------------------------------------------------------------------------------------------------

  /** Builds the cards again from `config`. It runs when an agent is added or removed, never while someone types. */
  function renderAgents() {
    container.replaceChildren();
    config.agents.forEach((agent, index) => container.append(card(agent, index)));
  }

  function card(agent: AgentConfig, index: number): DocumentFragment {
    const fragment = template.content.cloneNode(true) as DocumentFragment;
    const root = query<HTMLElement>(fragment, ".agent-card");
    query(root, "[data-agent-title]").textContent = `Agent ${index + 1}`;

    const remove = query<HTMLButtonElement>(root, "[data-remove-agent]");
    remove.setAttribute("aria-label", `Remove agent ${index + 1}`);
    remove.hidden = config.agents.length < 2;
    remove.addEventListener("click", () => {
      if (config.agents.length < 2) return;
      config.agents.splice(index, 1);
      renderAgents();
      update();
    });

    for (const name of ["name", "phone", "hours", "cta", "message"] as TextField[]) {
      const field = query<HTMLInputElement | HTMLTextAreaElement>(root, `[data-field="${name}"]`);
      const id = `agent-${index}-${name}`;
      field.id = id;
      query(root, `[data-for="${name}"]`).setAttribute("for", id);
      field.value = agent[name];
      field.addEventListener("input", () => {
        agent[name] = field.value;
        update();
      });
    }

    root.querySelectorAll<HTMLElement>("[data-day]").forEach((row, day) => dayRow(agent, index, row, day));
    return fragment;
  }

  /** One day of the week: the switch, and the two times that show when the switch is on. */
  function dayRow(agent: AgentConfig, agentIndex: number, row: HTMLElement, day: number) {
    const name = DAY_NAMES[day]!;
    const nameElement = query<HTMLElement>(row, "[data-day-name]");
    const toggle = query<HTMLInputElement>(row, "[data-switch]");
    const times = query<HTMLElement>(row, "[data-times]");
    const [open, close] = row.querySelectorAll<HTMLInputElement>("[data-time]") as unknown as [
      HTMLInputElement,
      HTMLInputElement,
    ];

    nameElement.id = `day-${agentIndex}-${day}`;
    toggle.setAttribute("aria-labelledby", nameElement.id);
    times.id = `time-${agentIndex}-${day}`;
    open.setAttribute("aria-label", `${name} opening time`);
    close.setAttribute("aria-label", `${name} closing time`);

    const show = (on: boolean) => {
      toggle.checked = on;
      times.toggleAttribute("data-on", on);
    };
    const entry = agent.schedule[day];
    show(worksOn(agent, day));
    open.value = timeValue(entry?.[0] ?? "09:00");
    close.value = timeValue(entry?.[1] ?? "18:00");

    toggle.addEventListener("change", () => {
      if (toggle.checked) {
        agent.schedule[day] = ["09:00", "18:00"];
        open.value = "09:00";
        close.value = "18:00";
      } else {
        agent.schedule[day] = null;
      }
      show(toggle.checked);
      update();
    });

    const setTime = (position: 0 | 1, input: HTMLInputElement) => {
      const current = agent.schedule[day] ?? ["09:00", "18:00"];
      current[position] = input.value;
      agent.schedule[day] = current;
      update();
    };
    open.addEventListener("input", () => setTime(0, open));
    close.addEventListener("input", () => setTime(1, close));
  }

  query<HTMLButtonElement>(document, "[data-add-agent]").addEventListener("click", () => {
    config.agents.push(newAgent());
    renderAgents();
    update();
  });

  // Copy ----------------------------------------------------------------------------------------------------------

  async function copyText(text: string) {
    try {
      await navigator.clipboard.writeText(text);
      return true;
    } catch {
      // A page that is not served over HTTPS has no clipboard API; the older command still works from a click.
      const area = document.createElement("textarea");
      area.value = text;
      document.body.append(area);
      area.select();
      const done = document.execCommand("copy");
      area.remove();
      return done;
    }
  }

  let copyTimer: number | undefined;
  copyButton.addEventListener("click", async () => {
    const copied = await copyText(output.textContent ?? "");
    copyStatus.textContent = copied ? "Copied" : "Could not copy. Select the code and copy it.";
    window.clearTimeout(copyTimer);
    copyTimer = window.setTimeout(() => (copyStatus.textContent = ""), 2000);
  });

  renderAgents();
</script>
