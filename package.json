{
	"name": "whatsapp-widget",
	"version": "3.3.7",
	"description": "Whatsapp widget",
	"private": true,
	"cdn": "https://cdn.jsdelivr.net/gh/miguelcolmenares/whatsapp-widget",
	"scripts": {
		"build": "npm run build:clean && npm run build:js && npm run build:css && npm run build:cleanup",
		"build:clean": "rm -rf dist",
		"build:cleanup": "rm -f dist/css/whatsapp-widget-styles.js",
		"build:js": "vite build",
		"build:css": "BUILD_MODE=css vite build",
		"site:widget": "rm -rf site/public/dist && cp -R dist site/public/dist",
		"site:build": "npm run build && npm run site:widget && npm --prefix site run build",
		"lint": "npx eslint src/ --quiet --fix",
		"prettier": "prettier --write src/",
		"test": "npx jest --coverage --verbose",
		"test:e2e": "playwright test -c e2e/playwright.config.ts"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/miguelcolmenares/whatsapp-widget.git"
	},
	"author": "Miguel Colmenares <me@miguelcolmenares.com>",
	"license": "Apache",
	"bugs": {
		"url": "https://github.com/miguelcolmenares/whatsapp-widget/issues"
	},
	"homepage": "https://github.com/miguelcolmenares/whatsapp-widget#readme",
	"devDependencies": {
		"@axe-core/playwright": "^4.14.0",
		"@eslint/eslintrc": "^3.3.7",
		"@eslint/js": "^10.0.1",
		"@playwright/test": "^1.64.1",
		"@tsconfig/recommended": "^1.0.13",
		"@types/jest": "^30.0.0",
		"@typescript-eslint/eslint-plugin": "^8.72.1",
		"@typescript-eslint/parser": "^8.72.1",
		"autoprefixer": "^10.6.2",
		"eslint": "^10.14.0",
		"globals": "^17.14.0",
		"jest": "^30.5.2",
		"jest-environment-jsdom": "^30.5.2",
		"less": "^4.9.1",
		"postcss-less": "^7.0.1",
		"prettier": "^3.9.10",
		"striptags": "^3.2.0",
		"terser": "^5.51.2",
		"ts-jest": "^29.4.15",
		"ts-node": "^10.9.2",
		"typescript": "^7.0.2",
		"vite": "^8.3.5",
		"vite-plugin-dts": "^5.1.2",
		"vite-plugin-static-copy": "^4.1.1"
	},
	"overrides": {
		"js-yaml": "^4.3.2",
		"minimatch@^9.0.0": "^11.0.1",
		"minimatch@^10.0.0": "^11.0.1"
	},
	"engines": {
		"node": ">=20",
		"npm": ">=10",
		"yarn": ">=1.22.5"
	}
}
